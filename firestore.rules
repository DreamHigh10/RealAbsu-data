rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'brossj15@gmail.com' ||
        request.auth.token.email.lower() == 'ogunbadekehinde19@gmail.com' ||
        request.auth.token.email.lower() == 'ogungbadekehinde19@gmail.com' ||
        request.auth.token.email.lower() == 'brossj50@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role == 'super_admin')
      );
    }

    function isCoAdmin() {
      return request.auth != null && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
         (get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role == 'co_admin' ||
          get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.role == 'admin'))
      );
    }

    match /staff/{document} {
      // Super admins and Co-admins can read and update staff records
      // All authenticated users can create staff records
      // Regular staff members can only read and update their own document
      allow read: if request.auth != null && (
        isSuperAdmin() ||
        isCoAdmin() ||
        (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower()) ||
        (resource.data.userId != null && resource.data.userId == request.auth.uid)
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        isCoAdmin() ||
        (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower()) ||
        (resource.data.userId != null && resource.data.userId == request.auth.uid)
      );
      allow delete: if request.auth != null && isSuperAdmin();
    }

    match /admins/{document} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /messages/{document} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isSuperAdmin() || isCoAdmin());
      allow delete: if request.auth != null && isSuperAdmin();
    }

    match /news/{document} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || isCoAdmin();
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
